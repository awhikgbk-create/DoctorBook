<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - DoctorBook</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index">Doctor<span>Book</span></a><nav><a asp-controller="Home" asp-action="Index">الرئيسية</a><a asp-controller="Doctors" asp-action="Index">الأطباء</a>
@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Notifications" asp-action="Index">الإشعارات</a><a asp-controller="Appointments" asp-action="MyAppointments">حجوزاتي</a>
@if(User.IsInRole("Doctor")){<a asp-controller="DoctorDashboard" asp-action="Index">لوحة الطبيب</a>}
@if(User.IsInRole("Admin")){<a asp-controller="Admin" asp-action="Index">الإدارة</a>}}
</nav><div class="account">@if(User.Identity?.IsAuthenticated==true){<span>@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button">خروج</button></form>}else{<a asp-controller="Account" asp-action="Login">دخول</a><a class="btn small" asp-controller="Account" asp-action="Register">حساب جديد</a>}</div></header>
<main>@if(TempData["Message"]!=null){<div class="notice">@TempData["Message"]</div>}@if(TempData["Error"]!=null){<div class="error">@TempData["Error"]</div>}@RenderBody()</main><footer>© @DateTime.Now.Year DoctorBook — منصة لتنظيم البحث عن الأطباء وحجز المواعيد.</footer><script src="~/js/site.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>

@model IEnumerable<DoctorProfile>
@{ViewData["Title"]="الرئيسية";}
<section class="hero"><div class="hero-content"><span class="eyebrow">رعايتك تبدأ بخطوة</span><h1>اعثر على الطبيب المناسب<br/><span>واحجز موعدك بسهولة</span></h1><p>ابحث حسب التخصص أو المدينة، واستعرض بيانات الأطباء ومواعيد الحجز.</p><form method="get" class="search-box"><input name="specialty" value="@ViewBag.Specialty" placeholder="التخصص"/><input name="city" value="@ViewBag.City" placeholder="المدينة"/><button class="btn">ابحث الآن</button></form></div><div class="hero-art">✚</div></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">اختيارات موثوقة</span><h2>أطباء مقترحون</h2></div><a asp-controller="Doctors" asp-action="Index">كل الأطباء ←</a></div><div class="doctor-grid">@foreach(var d in Model){<article class="doctor-card"><div class="avatar">✚</div><span class="tag">@d.Specialty</span><h3>@d.FullName</h3><p>📍 @d.City</p><p>@d.Bio</p><div class="card-bottom"><strong>@d.ConsultationPrice.ToString("0") جنيه</strong><a class="btn small" asp-controller="Doctors" asp-action="Details" asp-route-id="@d.Id">الملف الشخصي</a></div></article>}</div></section>

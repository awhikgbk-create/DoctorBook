@model RegisterViewModel
@{ViewData["Title"]="إنشاء حساب";}
<section class="section page-section"><div class="form-card"><h1>إنشاء حساب جديد</h1><form asp-action="Register" method="post"><div asp-validation-summary="All" class="validation"></div><label>الاسم بالكامل</label><input asp-for="FullName"/><label>البريد الإلكتروني</label><input asp-for="Email"/><label>رقم الهاتف</label><input asp-for="PhoneNumber"/><label>نوع الحساب</label><select asp-for="AccountType" id="accountType"><option value="Patient">مريض</option><option value="Doctor">طبيب</option></select><div id="doctorFields" class="doctor-fields"><label>التخصص</label><input asp-for="Specialty"/><label>المدينة</label><input asp-for="City"/><label>نبذة</label><textarea asp-for="Bio"></textarea><label>سعر الكشف</label><input asp-for="ConsultationPrice" type="number" min="0"/></div><label>كلمة المرور (8 أحرف على الأقل)</label><input asp-for="Password"/><label>تأكيد كلمة المرور</label><input asp-for="ConfirmPassword"/><button class="btn">إنشاء الحساب</button></form></div></section>
@section Scripts{<script>const t=document.getElementById('accountType'),f=document.getElementById('doctorFields');function toggle(){f.style.display=t.value==='Doctor'?'block':'none'}t.addEventListener('change',toggle);toggle();</script>}

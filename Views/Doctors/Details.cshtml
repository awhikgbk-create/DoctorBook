@model DoctorProfile
@{ViewData["Title"]=Model.FullName;}
<section class="section page-section"><div class="profile-card"><div class="avatar large">✚</div><span class="tag">@Model.Specialty</span><h1>@Model.FullName</h1><p>📍 @Model.City</p><p>@Model.Bio</p><p>العنوان: @Model.ClinicAddress</p><p>للتواصل: @Model.PublicPhone</p><h3>سعر الكشف: @Model.ConsultationPrice.ToString("0") جنيه</h3><h3>أوقات العمل</h3>@if(!Model.Schedules.Any(x=>x.IsActive)){<p>لم يضف الطبيب مواعيد العمل بعد.</p>}else{<ul class="schedule-list">@foreach(var s in Model.Schedules.Where(x=>x.IsActive)){<li>@System.Globalization.CultureInfo.GetCultureInfo("ar-EG").DateTimeFormat.GetDayName((DayOfWeek)s.DayOfWeek): @s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</li>}</ul>}@if(User.Identity?.IsAuthenticated==true && User.IsInRole("Patient")){<a class="btn" asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@Model.Id">احجز موعدًا</a>}else{<a class="btn" asp-controller="Account" asp-action="Login">سجل الدخول للحجز</a>}</div></section>
